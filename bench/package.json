{
  "name": "@kontext-brain/bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm --dir .. exec vitest run --config bench/vitest.rag-eval-v2.config.ts",
    "typecheck": "pnpm --dir .. exec tsc -p bench/tsconfig.rag-eval-v2.json",
    "start": "node --import tsx src/run.ts",
    "ralph": "node --import tsx src/ralph.ts",
    "squad": "node --import tsx src/squad-run.ts",
    "structured": "node --import tsx src/structured-bench.ts",
    "hotpot": "node --import tsx src/hotpot-run.ts",
    "dump-contexts": "node --import tsx src/dump-contexts.ts",
    "dump-contexts-baseline": "node --import tsx src/dump-contexts-baseline.ts",
    "dump-contexts-multihop": "node --import tsx src/dump-contexts-multihop.ts",
    "score-claude": "node --import tsx src/score-claude.ts",
    "gb-dump": "node --import tsx src/gb-dump-contexts.ts",
    "gb-score": "node --import tsx src/gb-score.ts",
    "gb-compare": "node --import tsx src/gb-controlled-compare.ts",
    "gb-llm-answer": "node --import tsx src/gb-llm-answer.ts",
    "gb-llm-judge": "node --import tsx src/gb-llm-judge.ts",
    "gb-dump-kg": "node --import tsx src/gb-dump-kg.ts",
    "merge-claude-kg": "node --import tsx src/merge-claude-kg.ts",
    "code-quality": "node --import tsx src/code-quality-eval/cli.ts",
    "code-quality:large": "node --import tsx src/code-quality-eval/large-scale/cli.ts",
    "code-quality:real-oss": "node --import tsx src/code-quality-eval/real-oss/cli.ts",
    "code-quality:deepswe": "node --import tsx src/code-quality-eval/deepswe/cli.ts",
    "code-quality:deepswe:export": "node --import tsx src/code-quality-eval/deepswe/export-cli.ts",
    "test:code-quality": "pnpm --dir .. exec vitest run --config bench/vitest.code-quality.config.ts",
    "typecheck:code-quality": "pnpm --dir .. exec tsc -p bench/tsconfig.code-quality.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@kontext-brain/code": "workspace:*",
    "@kontext-brain/core": "workspace:*",
    "@kontext-brain/context": "workspace:*",
    "@kontext-brain/llm": "workspace:*",
    "@kontext-brain/loader": "workspace:*",
    "@kontext-brain/local": "workspace:*",
    "@kontext-brain/mcp": "workspace:*",
    "@kontext-brain/spec": "workspace:*",
    "@langchain/core": "^0.3.27",
    "@langchain/ollama": "^0.1.4"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
